{
  "name": "roots/sage",
  "type": "wordpress-theme",
  "license": "MIT",
  "description": "WordPress starter theme with a modern development workflow",
  "homepage": "https://roots.io/sage/",
  "authors": [
    {
      "name": "Ben Word",
      "email": "ben@benword.com",
      "homepage": "https://github.com/retlehs"
    },
    {
      "name": "Scott Walkinshaw",
      "email": "scott.walkinshaw@gmail.com",
      "homepage": "https://github.com/swalkinshaw"
    },
    {
      "name": "QWp6t",
      "email": "hi@qwp6t.me",
      "homepage": "https://github.com/qwp6t"
    }
  ],
  "keywords": ["wordpress"],
  "support": {
    "issues": "https://github.com/roots/sage/issues",
    "forum": "https://discourse.roots.io/"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "repositories": [
    { "type": "vcs", "url": "https://github.com/jeh5256/sage-installer" },
    { "type": "vcs", "url": "https://github.com/jeh5256/sage-lib" }
  ],
  "require": {
    "php": ">=8.0",
    "composer/installers": "^2.0",
    "illuminate/support": "8.83.27",
    "roots/sage-lib": "dev-master#9be12aca39e147d2020d48256936ac4b487dde1e",
    "soberwp/controller": "~2.1.2",
    "roots/sage-installer": "dev-master#50c9698601eb7920bbf0d3fdb4ca54625a5944f9",
    "roots/sage-woocommerce": "^1.0",
    "automattic/woocommerce": "^3.0",
    "illuminate/config": "^8.0",
    "nesbot/carbon": "^2.72",
    "kylekatarnls/laravel-carbon-2": "^1.0.0"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^2.8.0",
    "filp/whoops": "^2.12"
  },
  "scripts": {
    "test": ["phpcs"],
    "post-create-project-cmd": [
      "Roots\\Sage\\Installer\\ComposerScript::postCreateProject"
    ]
  },
  "config": {
    "platform-check": true,
    "allow-plugins": {
      "composer/installers": true
    }
  }
}
